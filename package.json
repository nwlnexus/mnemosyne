{
  "name": "@nwlnexus/mnemosyne",
  "version": "0.1.0",
  "description": "mnemosyne — extract → route → dispatch session learnings CLI",
  "type": "module",
  "bin": {
    "mnemosyne": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nwlnexus/mnemosyne.git"
  },
  "homepage": "https://github.com/nwlnexus/mnemosyne#readme",
  "bugs": {
    "url": "https://github.com/nwlnexus/mnemosyne/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "prepare": "husky",
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.5",
    "@types/node": "^26.1.0",
    "husky": "^9.1.7",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
